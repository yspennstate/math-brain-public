{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-s",
              "{{DREAMING}}\\coactivation_log.py"
            ],
            "timeout": 600
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-s",
              "{{DREAMING}}\\spread_recall.py"
            ],
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-s",
              "{{DREAMING}}\\error_monitor.py"
            ],
            "timeout": 600
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" -B -c \"import os,runpy,sys;os.environ['ERROR_GRAPH_MODE']='shadow';os.environ['ERROR_GRAPH_RUNTIME_HINT']='claude';p=bytes.fromhex('{{ERROR_GRAPH_HEX}}').decode('utf-8');sys.path.insert(0,p);runpy.run_path(os.path.join(p,'hook.py'),run_name='__main__')\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-s",
              "{{DREAMING}}\\ps1_guard.py"
            ],
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-s",
              "{{DREAMING}}\\instinct_prime.py"
            ],
            "timeout": 600
