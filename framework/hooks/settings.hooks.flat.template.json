              "{{FLEET}}\\mailbox_hook.py"
            ],
            "timeout": 600
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-s",
              "{{DREAMING}}\\gap_watch_hook.py"
            ],
            "timeout": 600
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-s",
              "{{DREAMING}}\\proof_deny_hook.py"
            ],
            "timeout": 600
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" -B -c \"import os,runpy,sys;os.environ['ERROR_GRAPH_MODE']='shadow';os.environ['ERROR_GRAPH_RUNTIME_HINT']='claude';p=bytes.fromhex('{{ERROR_GRAPH_HEX}}').decode('utf-8');sys.path.insert(0,p);runpy.run_path(os.path.join(p,'hook.py'),run_name='__main__')\"",
