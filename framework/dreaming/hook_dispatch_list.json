{
  "PostToolUse": [
    {
      "matcher": "Read",
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": [
            "-s",
            "{{DREAMING}}\\coactivation_log.py"
          ],
          "timeout": 600
        },
        {
          "type": "command",
          "command": "python",
          "args": [
            "-s",
            "{{DREAMING}}\\spread_recall.py"
          ],
          "timeout": 600
        }
      ]
    },
    {
      "matcher": "Bash|PowerShell",
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": [
            "-s",
            "{{DREAMING}}\\error_monitor.py"
          ],
          "timeout": 600
        }
      ]
    },
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "\"{{PYTHON}}\" -s -B -c \"import os,runpy,sys;os.environ['ERROR_GRAPH_MODE']='shadow';os.environ['ERROR_GRAPH_RUNTIME_HINT']='claude';p=bytes.fromhex('{{ERROR_GRAPH_HEX}}').decode('utf-8');sys.path.insert(0,p);runpy.run_path(os.path.join(p,'hook.py'),run_name='__main__')\"",
          "timeout": 600
        }
      ]
    },
    {
      "matcher": "Edit|Write",
      "hooks": [
        {
          "type": "command",
          "command": "python -s \"{{DREAMING}}/ps1_guard.py\"",
          "timeout": 600
        }
      ]
    },
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": [
            "-s",
            "{{DREAMING}}\\live_inbox_hook.py"
          ],
          "timeout": 30,
          "enabled_if": "~/.agents/live_inbox/HOOK_ON"
        }
      ]
    },
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": [
            "-s",
            "{{DREAMING}}\\compact_hooks.py"
          ],
          "timeout": 60
        }
      ]
    },
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": [
            "-s",
            "{{DREAMING}}\\graph_membrane_hook.py"
          ],
          "timeout": 60,
          "enabled_if": "~/.claude/brain_graph/live/HOOK_ENABLED"
        }
      ]
    }
  ],
