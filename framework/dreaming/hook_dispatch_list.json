  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "powershell",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "{{CLAUDE_DIR}}\\wake_brain.ps1",
