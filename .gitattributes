# The population export is a byte-deterministic snapshot: export_store.py compares it
# against the live store and import_store.py rebuilds from it, so it must check out
# identically on every machine. core.autocrlf is on for this checkout, which would
# rewrite these files to CRLF on Windows and make a cross-OS digest comparison lie.
export/population/*.jsonl text eol=lf
export/population/MANIFEST.json text eol=lf
# navigation/ is checked against its MANIFEST.json digests on load, for the same reason.
navigation/*.jsonl text eol=lf
navigation/MANIFEST.json text eol=lf

*.py text eol=lf
# Archived run scripts under results/ and papers/ are kept byte for byte as they ran,
# with the line endings they were written with; several folders list their sha256.
# Leave them unconverted so a fresh clone does not report them as modified.
results/**/*.py -text
papers/**/*.py -text
