    let lo := fun (m r : Int) => m - r
    let hi := fun (m r : Int) => m + r
    let pmin := fun (a b c d : Int) =>
      min (min (a * c) (a * d)) (min (b * c) (b * d))
    let pmax := fun (a b c d : Int) =>
      max (max (a * c) (a * d)) (max (b * c) (b * d))
