    decide (0 <= r10) && decide (0 <= r11) &&
    decide (pmax (lo m01 r01) (hi m01 r01) (lo m10 r10) (hi m10 r10)
            < pmin (lo m00 r00) (hi m00 r00) (lo m11 r11) (hi m11 r11))


