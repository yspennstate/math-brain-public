+    {
+      "key": "poisson",
+      "namespace": "analysis.spectral",
+      "logical_name": "spectral-poisson-transform-unnormalized",
+      "kind": "definition",
+      "title": "Unnormalized spectral Poisson transform",
+      "statement": "For a probability Borel measure mu on R and eta>0, define F_eta(E)=integral_R eta/((t-E)^2+eta^2) dmu(t). For a unit vector's spectral measure of a self-adjoint H, F_eta(E)=Im <u,(H-E-i eta)^(-1)u>. The kernel has total Lebesgue integral pi.",
+      "proof_text": null,
+      "assumptions": [
+        "mu is a probability Borel measure",
+        "eta>0",
+        "unit-vector spectral measure when H is used"
+      ],
+      "domain": "probability and spectral theory",
+      "source": {
