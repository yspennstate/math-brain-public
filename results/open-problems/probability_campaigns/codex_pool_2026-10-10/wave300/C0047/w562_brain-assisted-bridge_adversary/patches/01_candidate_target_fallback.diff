+"""Optional bounded retrieval of exact campaign cards; no ranking or store mutation.
+
+Use only when a candidate ID is known. These are draft/attempt records, not proof
+certificates. This helper does not resolve current-note or supersession chains.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import re
+import sqlite3
+import time
+
+
+def lookup_candidate(database: Path, candidate_id: str, *, budget_seconds: float = 2.0) -> dict:
+    if not re.fullmatch(r"[A-Z]\d{4}", candidate_id):
+        raise ValueError("candidate_id must be an uppercase letter followed by four digits")
+    if not 0 < budget_seconds <= 5:
+        raise ValueError("budget_seconds must be in (0,5]")
+    database=Path(database).resolve(strict=True)
+    start=time.perf_counter()
+    prefix=candidate_id.lower()
+    with sqlite3.connect(database.as_uri()+"?mode=ro",uri=True,timeout=min(1,budget_seconds)) as con:
+        con.row_factory=sqlite3.Row
+        con.execute("PRAGMA query_only=ON")
+        con.set_progress_handler(lambda: int(time.perf_counter()-start>=budget_seconds),1000)
+        rows=con.execute(
+            "SELECT id,kind,title,body,metadata_json,digest FROM nodes "
+            "WHERE json_extract(metadata_json,'$.bundle_entry_key') IN (?,?) LIMIT 5",
+            ("op-"+prefix,"at-"+prefix),
+        ).fetchall()
+    if len(rows)>4:
+        raise ValueError("ambiguous candidate: more than four revisions; use current-note retrieval")
+    cards=[]
+    for row in rows:
+        card=dict(row)
+        card["metadata"]=json.loads(card.pop("metadata_json"))
+        cards.append(card)
+    return {
+        "candidate_id":candidate_id,
+        "retrieval_mode":"exact-bundle-entry-key",
+        "read_only":True,
+        "elapsed_seconds":time.perf_counter()-start,
+        "budget_seconds":budget_seconds,
+        "warning":"Draft/attempt cards only. Check full hypotheses, primary sources and current revisions before mathematical use. No proof certification or supersession resolution.",
+        "cards":cards,
+    }
+
+
+def main() -> int:
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("database",type=Path)
+    parser.add_argument("candidate_id")
+    args=parser.parse_args()
+    print(json.dumps(lookup_candidate(args.database,args.candidate_id),ensure_ascii=False,indent=2))
+    return 0
+
+
+if __name__=="__main__":
+    raise SystemExit(main())
