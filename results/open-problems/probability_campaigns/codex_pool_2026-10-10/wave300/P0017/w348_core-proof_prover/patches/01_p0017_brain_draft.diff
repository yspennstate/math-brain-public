+    {
+      "key": "tilt-tensor",
+      "namespace": "probability.functional",
+      "logical_name": "normalized-ordered-tilt-taylor-tensor",
+      "kind": "concept",
+      "title": "Normalized ordered Taylor tensor of an exponential tilt average",
+      "statement": "For a centered probability mu on R^n with exponential moments in a neighborhood of zero and f in L2(mu), define F_f(z)=integral f(x)exp(<z,x>) dmu(x)/integral exp(<z,x>) dmu(x) near zero. The degree-d Taylor tensor is T_d f=(1/d!)D^d F_f(0). Its Hilbert--Schmidt norm sums the squares of all n^d ordered-index entries. For a multi-index alpha of total degree d, if c_alpha is the coefficient of z^alpha in F_f, those entries equal (alpha!/d!)c_alpha, and their multiplicity is d!/alpha!. Thus ||T_df||^2=sum_{|alpha|=d}(alpha!/d!)|c_alpha|^2.",
+      "proof_text": null,
+      "assumptions": [
+        "d>=1 integer",
+        "f in L2(mu)",
+        "Local exponential integrability; choose a smaller neighborhood for the L2 tilt kernel"
+      ],
+      "domain": "probability theory and Hilbert tensor algebra",
