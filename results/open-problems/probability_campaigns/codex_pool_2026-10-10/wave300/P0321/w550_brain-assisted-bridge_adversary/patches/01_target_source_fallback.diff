--- a/~/.claude/dreaming/target_source_fallback.py
+++ b/~/.claude/dreaming/target_source_fallback.py
@@ -0,0 +1,80 @@
+"""Bounded exact-card fallback after recall fails. It never writes to a store.
+
+This is a proposed standalone helper, not a change to global recall controls.
+An exact locator is required; this is not ranked retrieval or a proof checker.
+"""
+import argparse
+import json
+import pathlib
+import re
+import subprocess
+import time
+
+
+def lookup(source, key, *, timeout=3.0, max_lines=128, max_bytes=65536):
+    started = time.perf_counter()
+    path = pathlib.Path(source)
+    if not key or len(key) > 256 or not path.is_file():
+        return {"state": "abstained", "reason": "invalid exact locator"}
+    pattern = r'"key"\s*:\s*' + re.escape(json.dumps(key)) + r'\s*[,}]'
+    try:
+        p = subprocess.run(["rg", "-n", "-m", "2", "--", pattern, str(path)],
+                           capture_output=True, text=True, encoding="utf-8",
+                           errors="strict", timeout=timeout)
+    except (OSError, UnicodeError, subprocess.TimeoutExpired) as e:
+        return {"state": "abstained", "reason": type(e).__name__}
+    matches = p.stdout.splitlines()
+    if p.returncode not in (0, 1) or len(matches) != 1:
+        return {"state": "abstained", "reason": "missing, ambiguous, or unreadable key"}
+    try:
+        lineno = int(matches[0].split(":", 1)[0])
+        decoder = json.JSONDecoder()
+        text = "{\n"
+        card = None
+        with path.open(encoding="utf-8-sig") as handle:
+            for i, line in enumerate(handle, 1):
+                if time.perf_counter()-started > timeout:
+                    return {"state": "abstained", "reason": "lookup deadline"}
+                if i < lineno:
+                    continue
+                if i-lineno >= max_lines:
+                    break
+                text += line
+                if len(text.encode("utf-8")) > max_bytes:
+                    break
+                try:
+                    candidate, _ = decoder.raw_decode(text)
+                except json.JSONDecodeError:
+                    continue
+                card = candidate
+                break
+    except (ValueError, OSError, UnicodeError) as e:
+        return {"state": "abstained", "reason": type(e).__name__}
+    if not isinstance(card, dict) or card.get("key") != key:
+        return {"state": "abstained", "reason": "unsupported card layout or bounds exceeded"}
+    required = {"kind", "statement", "assumptions", "source"}
+    if not required.issubset(card) or not isinstance(card["statement"], str) or not card["statement"].strip():
+        return {"state": "abstained", "reason": "incomplete card"}
+    # A retrieved item does not establish applicability, correctness, or openness.
+    # Preserve kind, assumptions, and source together instead of returning a title.
+    return {"state": "located", "source_path": str(path), "source_line": lineno,
+            "card": card, "evidence_role": "unverified_source_record",
+            "proof_witness": False, "current_openness": "UNKNOWN",
+            "applicability": "requires full hypothesis and source comparison"}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", required=True)
+    parser.add_argument("--key", required=True)
+    parser.add_argument("--timeout-seconds", type=float, default=3.0)
+    args = parser.parse_args()
+    if not 0 < args.timeout_seconds <= 10:
+        parser.error("timeout must be positive and at most 10 seconds")
+    result = lookup(args.source, args.key, timeout=args.timeout_seconds)
+    print(json.dumps(result, ensure_ascii=False))
+    return 0 if result["state"] == "located" else 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
