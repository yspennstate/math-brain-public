+      "key": "critical-witness-gap",
+      "namespace": "probability.statmech",
+      "logical_name": "potts-c0048-fixed-critical-cylinder-witness-missing-bridge",
+      "kind": "concept",
+      "title": "DRAFT open bridge: a fixed positive critical Potts boundary witness",
+      "statement": "Unproved proof need for C0048, not a theorem: for each integer q>=3 and d>=3 in the zero-field ferromagnetic nearest-neighbor model, find a fixed finite cylinder event A and delta(q,d)>0 with phi^w_{p_c,q}(A)-phi^f_{p_c,q}(A)>=delta. Under a monotone coupling, a witness on M edges would give a common edge-marginal gap at least delta/M, and under the Potts Gibbs/Edwards-Sokal assumptions a pressure slope gap at least d*delta/(p_c*M). The critical wired infinite-cluster conclusion still requires its full argument; no positive witness, critical free-state nonpercolation theorem, or parent-problem solution is supplied by this draft.",
+      "proof_text": null,
+      "assumptions": [
+        "integer q>=3,d>=3",
+        "nearest-neighbor ferromagnetic interactions",
+        "zero external field",
+        "p_c defined by wired critical percolation",
+        "the positive witness is unproved"
