+      "key": "finite-gap-misstep",
+      "namespace": "probability.statmech",
+      "logical_name": "finite-random-cluster-boundary-gap-limit-inference-refuted-route",
+      "kind": "concept",
+      "title": "DRAFT refuted route: finite boundary positivity as a transition certificate",
+      "statement": "Refuted inference, not a theorem: positive free/wired marginal differences in every finite volume by themselves imply a bulk first-order transition. The length-L endpoint-wired FK path has positive differences at every L, but for each fixed 0<p<1 and q>1 those differences tend geometrically to zero; its infinite-volume law is iid Bernoulli(p/[p+q(1-p)]). A valid critical-transition bridge needs a fixed-support positive limiting witness or a different argument.",
+      "proof_text": null,
+      "assumptions": [
+        "Inference is refuted in a path family; this does not refute C0048 on Z^d,d>=3"
+      ],
