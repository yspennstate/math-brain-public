        "artifact_path": "objects/sha256/a1/a10d65a4929c8a3f031e88e1b080058f93db3afcdf65f051d9f091cff363ef38.md",
        "bundle_digest": "sha256:86716fd1a28afc3252bfa2290ee8823f3c4c4e2b739e6e28d792e4d994c26fee",
        "bundle_entry_key": "thm-liouville",
        "bundle_id": "population.complex-info-knit-001",
