        "draft": "claude-mathbrain-build-0802/bundle_006.json",
        "evidence_ids": [],
        "logical_id": "math:analysis.complex:liouville-theorem-entire-bounded",
        "overlay_schema_version": 1,
        "proof_text": "The Cauchy integral formula for the first derivative on a circle of radius R centered at any point a gives |f'(a)| <= M / R (the Cauchy estimate: the integrand is bounded by M/R^2 over a contour of length 2 pi R). Letting R tend to infinity forces f'(a) = 0 at every a, so f has vanishing derivative everywhere on the connected set C and is constant.",
        "release_manifest_digest": "sha256:d633b5559b1b5364325dde61940f3e165fcfd028d75fdb6c254f766e01f5cddf",
        "revision_digest": "sha256:6fd97ac0926702a06e8171da0473c2c5f8209c21c0abafc14ce4d827b880e5e5",
        "source_id": "proofwiki:Liouville's Theorem (Complex Analysis)",
        "source_revision": "as-read-2026-08-02",
        "statement_fidelity_reviewed": false,
        "supersedes": [],
        "trust_class": "curated_secondary",
        "truth_status": "unverified"
      }
