+  "entries": [
+    {
+      "key": "axial-values",
+      "namespace": "probability.percolation",
+      "logical_name": "axial-monotone-and-undirected-passage-values",
+      "kind": "definition",
+      "title": "Axial monotone and unrestricted FPP passage values",
+      "statement": "On nearest-neighbor Z^2 with finite nonnegative edge weights, T_N is the infimum of sums along all paths from 0 to N e1. D_N is the infimum restricted to coordinatewise nondecreasing paths. There is exactly one such axial path, so D_N is the sum of its N horizontal edge weights. A restriction comparison concerns raw passage values unless separate deterministic centerings are explicitly specified.",
+      "proof_text": null,
+      "assumptions": [
+        "integer N>=1",
+        "finite nonnegative weights"
+      ],
+      "domain": "probability",
+      "source": {
+        "source_id": "owner:probability300:P0110:w379:axial-values",
+        "url": "file:///~/brain_workers/w379/INDEPENDENT.md",
