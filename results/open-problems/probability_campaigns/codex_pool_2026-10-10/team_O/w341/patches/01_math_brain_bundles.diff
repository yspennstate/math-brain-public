+      "logical_name": "c0034-projection-singleton-pair-laws",
+      "kind": "definition",
+      "title": "Rank-one and rank-two finite projection laws [audit pending w347]",
+      "statement": "For finite E and orthogonal unit vectors u,v in C^E, the projection law on span(u) chooses singleton {i} with mass |u_i|^2. The law on span(u,v) chooses {i,j}, i<j, with mass |u_i*v_j-u_j*v_i|^2. These are fixed-cardinality determinantal projection laws.",
+      "proof_text": null,
+      "assumptions": [
+        "E finite",
+        "u and v orthogonal unit vectors"
+      ],
+      "domain": "probability theory",
+      "source": {
+        "source_id": "owner-work:w341:c0034-projection-singleton-pair-laws",
+        "url": "file:///~/brain_workers/w341/proofs/C0034_rank_two.md",
