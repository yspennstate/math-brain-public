{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FEI mandatory correction projection",
  "type": "object",
  "required": [
    "schema_version",
    "programme_id",
    "control_revision",
    "state_revision",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "programme_id": {
      "type": "string",
      "minLength": 1
    },
    "control_revision": {
      "type": "string",
      "minLength": 1
    },
    "state_revision": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target_claim_id",
          "candidate_id",
          "action",
          "after_status",
          "scope_kind",
          "correction",
          "source_refs",
          "sources",
          "dependency_effect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target_claim_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "enum": [
              "REFUTE",
              "CLARIFY_SCOPE",
              "REFINE_CANDIDATE",
              "SUPERSEDE"
            ]
          },
          "after_status": {
            "enum": [
              "OPEN",
              "PROVED_IN_SOURCE",
              "REFUTED",
              "CANDIDATE_UNPROVED",
              "EQUIVALENT_REFORMULATION",
              "CONDITIONAL_IN_SOURCE",
              "FINITE_CHECK_IN_SOURCE",
              "NEEDS_REVALIDATION"
            ]
          },
          "scope_kind": {
            "enum": [
              "FULL_FEI",
              "CANDIDATE_GATE_INEQUALITY",
              "FINITE_WITNESS",
              "AUXILIARY_LEMMA",
              "EQUIVALENT_REFORMULATION",
              "FINITE_CHECK",
              "READ_ONCE",
              "BIAS_DEPENDENT",
              "LITERATURE"
            ]
          },
          "correction": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "repository",
                "commit",
                "path"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "locator": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": true
            }
          },
          "dependency_effect": {
            "enum": [
              "block_positive_descendants",
              "block_current_candidate_descendants",
              "scope_correction_only"
            ]
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
