{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FEI current claim projection",
  "type": "object",
  "required": [
    "schema_version",
    "programme_id",
    "control_revision",
    "state_revision",
    "full_fei_status",
    "global_independent_full_review",
    "sources",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "programme_id": {
      "type": "string",
      "minLength": 1
    },
    "control_revision": {
      "type": "string",
      "minLength": 1
    },
    "state_revision": {
      "type": "string",
      "minLength": 1
    },
    "full_fei_status": {
      "enum": [
        "OPEN",
        "PROOF_CANDIDATE",
        "VERIFIED_PROVED",
        "VERIFIED_REFUTED"
      ]
    },
    "global_independent_full_review": {
      "type": "boolean"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "repository",
          "commit",
          "path"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "locator": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "scope_kind",
          "scope",
          "statement",
          "candidate_id",
          "source_refs",
          "sources",
          "dependencies",
          "remaining_obligations",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "OPEN",
              "PROVED_IN_SOURCE",
              "REFUTED",
              "CANDIDATE_UNPROVED",
              "EQUIVALENT_REFORMULATION",
              "CONDITIONAL_IN_SOURCE",
              "FINITE_CHECK_IN_SOURCE",
              "NEEDS_REVALIDATION"
            ]
          },
          "scope_kind": {
            "enum": [
              "FULL_FEI",
              "CANDIDATE_GATE_INEQUALITY",
              "FINITE_WITNESS",
              "AUXILIARY_LEMMA",
              "EQUIVALENT_REFORMULATION",
              "FINITE_CHECK",
              "READ_ONCE",
              "BIAS_DEPENDENT",
              "LITERATURE"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "repository",
                "commit",
                "path"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "locator": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": true
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "claim_id",
                "role"
              ],
              "properties": {
                "claim_id": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "positive_result",
                    "definition_only",
                    "negative_result",
                    "historical_context",
                    "assumption",
                    "current_candidate"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "remaining_obligations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lifecycle": {
            "enum": [
              "CURRENT",
              "SUPERSEDED"
            ]
          },
          "verification": {
            "type": "object",
            "required": [
              "source_reported_status",
              "independent_full_proof_review"
            ],
            "properties": {
              "source_reported_status": {
                "type": "string",
                "minLength": 1
              },
              "independent_full_proof_review": {
                "type": "boolean"
              },
              "editor_spot_check": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope_extension_proof_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "independent_reviews": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "reviewer_id",
                    "source_ref",
                    "end_to_end"
                  ],
                  "properties": {
                    "reviewer_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "end_to_end": {
                      "const": true
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
