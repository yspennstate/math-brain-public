      <a href="/search/?searchtype=author&amp;query=Tenenbaum%2C+J+B">Joshua B. Tenenbaum</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Costa%2C+R+P">Rui Ponte Costa</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Mattar%2C+M+G">Marcelo G. Mattar</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tomov%2C+M">Momchil Tomov</a>
      
