      <name>Rosario Gonzalez-Ferez</name>
    </author>
    <author>
      <name>Peter Schmelcher</name>
    </author>
    <arxiv:doi>10.1088/1367-2630/11/5/055013</arxiv:doi>
    <link rel="related" href="https://doi.org/10.1088/1367-2630/11/5/055013" title="doi"/>
