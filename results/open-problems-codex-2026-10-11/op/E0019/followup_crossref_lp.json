ssref"}]}],"content-domain":{"domain":["iopscience.iop.org"],"crossmark-restriction":false},"short-container-title":["Nonlinearity"],"published-print":{"date-parts":[[2018,4,1]]},"abstract":"<jats:title>Abstract<\/jats:title>\n                  <jats:p>We consider a random dynamical system obtained by switching between the flows generated by two smooth vector fields on the 2d-torus, with the random switchings happening according to a Poisson process. Assuming that the driving vector fields are transversal to each other at all points of the torus and that each of them allows for a smooth invariant density and no periodic orbits, we prove that the switched system also has a smooth invariant density, for every switching rate. Our approach is based on an integration by parts formula inspired by techniques from Malliavin calculus.<\/jats:p>","DOI":"10.1088\/1361-6544\/aaa04f","type":"journal-article","created":{"date-parts":[[2018,2,20]],"date-time":"2018-02-20T12:47:59Z","timestamp":1519130879000},"page":"1331-1350","update-policy":"https:\/\/doi.org\/10.1088\/crossmark-policy","source":"Crossref","is-referenced-by-count":14,"title":["Smooth invariant densities for random switching on the torus"],"prefix":"10.1088","volume":"31","author":[{"given":"Yuri","family":"Bakhtin","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Tobias","family":"Hurth","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Sean D","family":"Lawley","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jonathan C","family":"Mattingly","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"266","published-online":{"date-parts":[[2018,2,20]]},"reference":[{"key":"nonaaa04fbib001","author":"Adams","year":"1975","type":"book"},{"key":"nonaaa04fbib002","doi-asserted-by":"publisher","first-page":"33","DOI":"1