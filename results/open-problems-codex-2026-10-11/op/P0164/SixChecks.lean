-- Kernel-checked integer rejection certificates: all listed cube vectors win,
-- and their nonempty positive sum is zero in every coordinate.
def cubeSign (x i : Nat) : Int := if x / 2^i % 2 = 1 then 1 else -1

def tradeCheck (c : Prod (List Nat) (List Nat)) : Bool :=
  (!c.2.isEmpty) && c.2.all (fun x => c.1.contains x) &&
  (List.range 6).all (fun i => (c.2.map (fun x => cubeSign x i)).sum == 0)

