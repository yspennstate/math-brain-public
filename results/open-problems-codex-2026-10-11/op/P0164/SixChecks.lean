def pc6 (x : Nat) : Nat := (Finset.range 6).sum fun i => if x / 2^i % 2 = 1 then 1 else 0

def overlap6 (x s : Nat) : Nat := (Finset.range 6).sum fun i =>
  if And (x / 2^i % 2 = 1) (s / 2^i % 2 = 1) then 1 else 0

def character6 (x s : Nat) : Int := if overlap6 x s % 2 = 0 then 1 else -1

def sixFunction (positive : List Nat) (x : Nat) : Int := if positive.contains x then 1 else -1

def coefficient6 (positive : List Nat) (s : Nat) : Int :=
  (Finset.range 64).sum fun x => sixFunction positive x * character6 x s

def level6 (positive : List Nat) (k : Nat) : Int :=
  (Finset.range 64).sum fun s => if pc6 s = k then (coefficient6 positive s)^2 else 0

def spectrum6 (positive : List Nat) : List Int := (List.range 7).map (level6 positive)

