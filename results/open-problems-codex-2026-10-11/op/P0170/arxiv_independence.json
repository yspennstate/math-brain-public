    <id>http://arxiv.org/abs/1012.1614v3</id>
    <title>$k$-Independent Gaussians Fool Polynomial Threshold Functions</title>
    <updated>2011-11-11T01:44:23Z</updated>
    <link href="https://arxiv.org/abs/1012.1614v3" rel="alternate" type="text/html"/>
