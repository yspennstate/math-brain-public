    </author>
    <author>
      <name>Bastien Mallein</name>
    </author>
    <author>
      <name>Michel Pain</name>
    </author>
    <arxiv:doi>10.1007/s00220-019-03465-w</arxiv:doi>
    <link rel="related" href="https://doi.org/10.1007/s00220-019-03465-w" title="doi"/>
