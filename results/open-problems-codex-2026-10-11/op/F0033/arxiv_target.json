      <name>Dhiraj Tapader</name>
    </author>
    <author>
      <name>Punyabrata Pradhan</name>
    </author>
    <author>
      <name>Deepak Dhar</name>
    </author>
    <arxiv:doi>10.1103/PhysRevE.103.032122</arxiv:doi>
    <link rel="related" href="https://doi.org/10.1103/PhysRevE.103.032122" title="doi"/>
