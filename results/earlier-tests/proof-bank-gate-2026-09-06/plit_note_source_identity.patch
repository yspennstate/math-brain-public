 rb.ITEMS = os.path.join(HERE, "items", "plit.jsonl")
 
 
+
+def _paper_family(value):
+    import re
+    paper = str(value or "").strip()
+    return re.sub(r"v[0-9]+$", "", paper)
+
+
+def _load_item_sources(path):
+    """Answer-free provenance only; bind source identity to all solver text."""
+    if not path:
+        return {}
+    import re
+    out = {}
+    fields = {"item_id", "item_sha256", "paper", "source_statement_sha256"}
+    with io.open(path, encoding="utf-8") as stream:
+        for line in stream:
+            if not line.strip():
+                continue
+            row = json.loads(line)
+            if not isinstance(row, dict) or set(row) != fields:
+                raise ValueError("item-source manifest has unexpected or missing fields")
+            iid = row["item_id"]
+            if not isinstance(iid, str) or not iid or iid in out:
+                raise ValueError("item-source manifest has invalid or duplicate item identity")
+            if any(not isinstance(row[k], str) or not re.fullmatch(r"[0-9a-f]{64}", row[k])
+                   for k in ("item_sha256", "source_statement_sha256")):
+                raise ValueError("item-source manifest requires full SHA256 values")
+            if not isinstance(row["paper"], str) or not _paper_family(row["paper"]):
+                raise ValueError("item-source manifest has no source paper")
+            out[iid] = row
+    return out
+
+
+def _source_identity(item, paper_of, manifest):
+    import hashlib
+    row = manifest.get(item["item_id"])
+    if row is not None:
+        blob = json.dumps(item, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
+        if hashlib.sha256(blob).hexdigest() != row["item_sha256"]:
+            raise ValueError("item-source manifest does not match the complete item: " + item["item_id"])
+        return "lit_" + row["source_statement_sha256"][:20], _paper_family(row["paper"])
+    own_id = "lit_" + hashlib.sha256(item["claim"].strip().encode("utf-8")).hexdigest()[:20]
+    paper = paper_of.get(own_id)
+    if not paper:
+        raise ValueError("cannot resolve source identity for exclusion; supply a hash-bound item-source manifest: " + item["item_id"])
+    return own_id, paper
+
+
